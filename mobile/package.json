{
  "name": "@hypermesh/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "HyperMesh mobile shell — React Native + Expo client connecting to the user's trusted daemon via Phase K.2 capability tokens. The phone is never a node — it is a remote client.",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:preview": "eas build --profile preview --platform all",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint placeholder — wire ESLint in C.4.5'"
  },
  "dependencies": {
    "@hypermesh/sdk": "file:../sdk/typescript",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@tanstack/react-query": "^5.40.0",
    "expo": "~50.0.0",
    "expo-document-picker": "~11.10.1",
    "expo-secure-store": "~12.8.1",
    "expo-status-bar": "~1.11.1",
    "nativewind": "^4.0.36",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "tailwindcss": "^3.4.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.45",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
