[Unit]
Description=HyperMesh Caesar EVP
Documentation=https://github.com/hypermesh-online/hypermesh
After=network-online.target blockmatrix.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/caesar --bind [::1]:9294
WorkingDirectory=/var/lib/hypermesh/caesar
Restart=on-failure
RestartSec=5
User=hypermesh
Group=hypermesh
LimitNOFILE=65536
Environment=RUST_LOG=info

# Security hardening
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hypermesh/caesar /var/log/hypermesh
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
