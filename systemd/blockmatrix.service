[Unit]
Description=HyperMesh Block-MATRIX Node
Documentation=https://github.com/hypermesh-online/hypermesh
After=network-online.target trustchain-stoq.service
Wants=network-online.target
Requires=trustchain-stoq.service

[Service]
Type=simple
ExecStart=/usr/local/bin/hypermesh --privacy public --reflector --stoq-port 9292 --network-id trustnet-test --data-dir /var/lib/hypermesh/blockmatrix connect public --foreground
WorkingDirectory=/var/lib/hypermesh/blockmatrix
Restart=on-failure
RestartSec=5
User=hypermesh
Group=hypermesh
LimitNOFILE=65536
Environment=RUST_LOG=info

# eBPF kernel gate (default security feature): the node loads/attaches its XDP
# program (hypermesh_xdp.o) so the kernel DROP mirrors the userspace PoS reject.
# XDP attach needs CAP_BPF + CAP_NET_ADMIN; granted as ambient caps to the
# otherwise-unprivileged hypermesh user (NOT full root). If the kernel/NIC does
# not support attach, the loader degrades gracefully to the userspace-only gate.
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN

# Security hardening
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hypermesh/blockmatrix /var/log/hypermesh /sys/fs/bpf
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
