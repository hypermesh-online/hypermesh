[Unit]
Description=HyperMesh Block-MATRIX Node
Documentation=https://github.com/hypermesh-online/core
After=network-online.target trustchain.service
Wants=network-online.target
Requires=trustchain.service

[Service]
Type=simple
ExecStart=/usr/local/bin/hypermesh --privacy public --reflector --stoq-port 9292 --network-id trustnet-test --data-dir /var/lib/hypermesh/blockmatrix connect public --foreground
WorkingDirectory=/var/lib/hypermesh/blockmatrix
Restart=on-failure
RestartSec=5
User=hypermesh
Group=hypermesh
LimitNOFILE=65536
Environment=RUST_LOG=info

# Security hardening
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hypermesh/blockmatrix /var/log/hypermesh
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
