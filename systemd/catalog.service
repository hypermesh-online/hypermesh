[Unit]
Description=HyperMesh Catalog STOQ Server
Documentation=https://github.com/hypermesh-online/core
After=network-online.target trustchain.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/catalog-server --bind [::1]:9295
WorkingDirectory=/var/lib/hypermesh/catalog
Restart=on-failure
RestartSec=5
User=hypermesh
Group=hypermesh
LimitNOFILE=65536
Environment=RUST_LOG=info

# Security hardening
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hypermesh/catalog /var/log/hypermesh
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
