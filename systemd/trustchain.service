[Unit]
Description=HyperMesh TrustChain CA
Documentation=https://github.com/hypermesh-online/core
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/trustchain
WorkingDirectory=/var/lib/hypermesh/trustchain
Restart=on-failure
RestartSec=5
User=hypermesh
Group=hypermesh
LimitNOFILE=65536
Environment=RUST_LOG=info

# Security hardening
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hypermesh/trustchain /var/log/hypermesh
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
