[Unit]
Description=HyperMesh Engauge Analytics STOQ Server
Documentation=https://github.com/hypermesh-online/core
After=network-online.target trustchain.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/engauge-server --bind [::1]:9296
WorkingDirectory=/var/lib/hypermesh/engauge
Restart=on-failure
RestartSec=5
User=hypermesh
Group=hypermesh
LimitNOFILE=65536
Environment=RUST_LOG=info

# Security hardening
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hypermesh/engauge /var/log/hypermesh
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
