[Unit]
Description=HyperMesh HTTP/3 Gateway
Documentation=https://github.com/hypermesh-online/hypermesh
# F9: the single trustchain.service was retired for the dual-CA split. The
# gateway bridges to the CA at [::1]:8444 (gateway.toml trustchain_addr), now
# served by trustchain-http3.service.
After=network-online.target trustchain-http3.service
Wants=network-online.target
Requires=trustchain-http3.service

[Service]
Type=simple
ExecStart=/usr/local/bin/gateway --config /etc/hypermesh/gateway.toml
WorkingDirectory=/var/lib/hypermesh/gateway
Restart=on-failure
RestartSec=5
User=hypermesh
Group=hypermesh
LimitNOFILE=65536
Environment=RUST_LOG=info

# Security hardening
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hypermesh/gateway /var/log/hypermesh /etc/hypermesh/certs
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
