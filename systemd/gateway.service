[Unit]
Description=HyperMesh HTTP/3 Gateway
Documentation=https://github.com/hypermesh-online/core
After=network-online.target trustchain.service
Wants=network-online.target
Requires=trustchain.service

[Service]
Type=simple
ExecStart=/usr/local/bin/gateway --config /etc/hypermesh/gateway.toml
WorkingDirectory=/var/lib/hypermesh/gateway
Restart=on-failure
RestartSec=5
User=hypermesh
Group=hypermesh
LimitNOFILE=65536
Environment=RUST_LOG=info

# Security hardening
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hypermesh/gateway /var/log/hypermesh /etc/hypermesh/certs
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
