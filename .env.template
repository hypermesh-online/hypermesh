# Web3 Ecosystem Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control

# =============================================================================
# TrustChain Configuration
# =============================================================================

# Certificate Authority Configuration
TRUSTCHAIN_CA_ID=trustchain-ca-production
TRUSTCHAIN_BIND_ADDRESS=::
TRUSTCHAIN_PORT=8443

# Certificate Paths (for production deployment)
# These should point to actual certificate files, not inline PEM data
TRUSTCHAIN_CERT_PATH=/path/to/production/server.crt
TRUSTCHAIN_KEY_PATH=/path/to/production/server.key
TRUSTCHAIN_CA_CERT_PATH=/path/to/production/ca.crt

# Certificate Transparency Log Configuration
TRUSTCHAIN_CT_LOG_ID=trustchain-ct-production
TRUSTCHAIN_CT_PORT=6962
TRUSTCHAIN_CT_STORAGE_PATH=/var/lib/trustchain/ct

# DNS Configuration
TRUSTCHAIN_DNS_SERVER_ID=trustchain-dns-production
TRUSTCHAIN_DNS_QUIC_PORT=8853
TRUSTCHAIN_DNS_PORT=53

# API Configuration
TRUSTCHAIN_API_SERVER_ID=trustchain-api-production
TRUSTCHAIN_API_PORT=8080
TRUSTCHAIN_API_RATE_LIMIT=300

# =============================================================================
# Gateway Configuration
# =============================================================================

GATEWAY_LISTEN_ADDR=[::]:8443
TRUSTCHAIN_ADDR=[::1]:50053
BLOCKMATRIX_ADDR=[::1]:8446

# Gateway Certificate Paths
GATEWAY_CERT_PATH=/path/to/gateway/server.crt
GATEWAY_KEY_PATH=/path/to/gateway/server.key

# Logging
LOG_LEVEL=info

# =============================================================================
# BlockMatrix Configuration
# =============================================================================

# Node Identity and Matrix Position
BLOCKMATRIX_NODE_ID=node_001
BLOCKMATRIX_MATRIX_X=0
BLOCKMATRIX_MATRIX_Y=0
BLOCKMATRIX_MATRIX_Z=0

# Network Configuration
BLOCKMATRIX_BIND_ADDRESS=::
BLOCKMATRIX_PORT=8446

# Storage Configuration
BLOCKMATRIX_STORAGE_PATH=/var/lib/blockmatrix/storage

# =============================================================================
# STOQ Protocol Configuration
# =============================================================================

# STOQ Transport Settings
STOQ_BIND_ADDRESS=::
STOQ_PORT=4433
STOQ_MAX_CONCURRENT_CONNECTIONS=10000

# Performance Tuning
STOQ_TARGET_THROUGHPUT_GBPS=2.95
STOQ_ENABLE_EBPF=true

# =============================================================================
# Caesar Exchange Configuration
# =============================================================================

# Banking API Integration (Sandbox/Production)
# IMPORTANT: Never commit actual API keys - use secure secret management in production

# Stripe Configuration
STRIPE_API_KEY=sk_test_your_stripe_key_here
STRIPE_ENVIRONMENT=sandbox  # sandbox or production

# Plaid Configuration
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENVIRONMENT=sandbox  # sandbox, development, or production

# OpenBanking Configuration
OPENBANKING_BASE_URL=https://api.openbanking.provider.com
OPENBANKING_CERT_PATH=/path/to/openbanking/client.crt
OPENBANKING_KEY_PATH=/path/to/openbanking/client.key

# =============================================================================
# Database Configuration
# =============================================================================

# Certificate Store Database
CERT_STORE_DB_PATH=/var/lib/trustchain/certs.db

# Consensus Store Database
CONSENSUS_STORE_DB_PATH=/var/lib/blockmatrix/consensus.db

# =============================================================================
# Security and Consensus Configuration
# =============================================================================

# Consensus Requirements
CONSENSUS_MINIMUM_STAKE=1000
CONSENSUS_REQUIRED_PROOFS=4  # PoSpace, PoStake, PoWork, PoTime
CONSENSUS_VALIDATION_TIMEOUT_SECS=30

# Security Settings
SECURITY_ENABLE_RATE_LIMITING=true
SECURITY_MAX_REQUEST_BODY_SIZE=10485760  # 10MB
SECURITY_SESSION_TIMEOUT_SECS=3600

# =============================================================================
# Monitoring and Metrics Configuration
# =============================================================================

# Metrics Export
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Telemetry
TELEMETRY_ENABLED=false
TELEMETRY_ENDPOINT=

# =============================================================================
# Development/Testing Configuration
# =============================================================================

# Override for testing/development (use 'localhost' or 'production')
DEPLOYMENT_MODE=localhost

# Enable debug logging for specific components
DEBUG_TRUSTCHAIN=false
DEBUG_BLOCKMATRIX=false
DEBUG_STOQ=false
DEBUG_CONSENSUS=false

# =============================================================================
# Additional Security Notes
# =============================================================================

# 1. In production, use a secret management system:
#    - HashiCorp Vault
#    - AWS Secrets Manager
#    - Azure Key Vault
#    - Kubernetes Secrets
#
# 2. Never commit .env file to version control
#    - Add .env to .gitignore
#    - Keep .env.template for documentation
#
# 3. Rotate credentials regularly
#    - API keys every 90 days minimum
#    - Certificates according to policy (24 hours for TrustChain)
#
# 4. Use least privilege principle
#    - Grant only necessary permissions
#    - Separate dev/staging/production credentials
#
# 5. Certificate paths should be file system paths
#    - Never embed PEM data in environment variables
#    - Use proper file permissions (600 for private keys)
